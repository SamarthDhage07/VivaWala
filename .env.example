# NeuralHire — Environment Variables
# Copy this to .env and fill in your values.
#
# ─────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────
# Choose: groq  (default — fast, free-tier cloud)
#         ollama (local, private, no API key)
LLM_PROVIDER=groq

# ─────────────────────────────────────────────
# Groq  (https://console.groq.com → API Keys)
# ─────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
# Automatically fall back to Ollama if Groq fails
GROQ_FALLBACK_TO_OLLAMA=true

# ─────────────────────────────────────────────
# Ollama  (local LLM, run: ollama serve)
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ─────────────────────────────────────────────
# Flask
# ─────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=true
PORT=5000
HOST=0.0.0.0

# ─────────────────────────────────────────────
# Interview
# ─────────────────────────────────────────────
DEFAULT_NUM_QUESTIONS=7

# ─────────────────────────────────────────────
# Speech-to-Text (Whisper model size)
# tiny | base | small | medium | large
# Larger = more accurate but slower to load
# ─────────────────────────────────────────────
WHISPER_MODEL=base

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
